{
  "name": "Momento 3 - Rendimiento académico",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "es-CO",
    "sourceQueryCulture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "Registros",
        "columns": [
          {
            "name": "Clave Nivel",
            "sourceColumn": "Clave Nivel",
            "dataType": "string",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Clave Semestre",
            "sourceColumn": "Clave Semestre",
            "dataType": "string",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Clave Género",
            "sourceColumn": "Clave Género",
            "dataType": "string",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Clave Ausencias",
            "sourceColumn": "Clave Ausencias",
            "dataType": "string",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Clave Clase",
            "sourceColumn": "Clave Clase",
            "dataType": "string",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Clave Asignatura",
            "sourceColumn": "Clave Asignatura",
            "dataType": "string",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Clave Grado",
            "sourceColumn": "Clave Grado",
            "dataType": "string",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Manos levantadas",
            "sourceColumn": "Manos levantadas",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "Recursos visitados",
            "sourceColumn": "Recursos visitados",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "Anuncios vistos",
            "sourceColumn": "Anuncios vistos",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "Discusiones",
            "sourceColumn": "Discusiones",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "Encuesta familiar",
            "sourceColumn": "Encuesta familiar",
            "dataType": "string",
            "summarizeBy": "none"
          },
          {
            "name": "ID de registro",
            "sourceColumn": "ID de registro",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "Puntaje codificado",
            "sourceColumn": "Puntaje codificado",
            "dataType": "int64",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Riesgo",
            "sourceColumn": "Riesgo",
            "dataType": "int64",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "measures": [
          {
            "name": "Observaciones",
            "expression": "COUNTROWS('Registros')",
            "formatString": "#,0"
          },
          {
            "name": "Índice medio",
            "expression": "AVERAGE('Registros'[Puntaje codificado])",
            "formatString": "0.0"
          },
          {
            "name": "Rendimiento bajo",
            "expression": "CALCULATE([Observaciones], KEEPFILTERS('Clase'[Clase de rendimiento] = \"Bajo\"))",
            "formatString": "#,0"
          },
          {
            "name": "% rendimiento bajo",
            "expression": "DIVIDE([Rendimiento bajo], [Observaciones], 0)",
            "formatString": "0.0%"
          },
          {
            "name": "Bajo en top 10",
            "expression": "VAR Materia = SELECTEDVALUE('Asignatura'[Asignatura])\nVAR Primeras = TOPN(10, ALLSELECTED('Asignatura'[Asignatura]), [Rendimiento bajo], DESC, 'Asignatura'[Asignatura], ASC)\nRETURN IF(CONTAINS(Primeras, 'Asignatura'[Asignatura], Materia), COALESCE([Rendimiento bajo], 0))",
            "formatString": "#,0"
          },
          {
            "name": "Rendimiento alto",
            "expression": "CALCULATE([Observaciones], KEEPFILTERS('Clase'[Clase de rendimiento] = \"Alto\"))",
            "formatString": "#,0"
          },
          {
            "name": "% rendimiento alto",
            "expression": "DIVIDE([Rendimiento alto], [Observaciones], 0)",
            "formatString": "0.0%"
          },
          {
            "name": "% riesgo académico",
            "expression": "DIVIDE(SUM('Registros'[Riesgo]), [Observaciones])",
            "formatString": "0.0%"
          },
          {
            "name": "Media de manos levantadas",
            "expression": "AVERAGE('Registros'[Manos levantadas])",
            "formatString": "0.0"
          },
          {
            "name": "Media de recursos visitados",
            "expression": "AVERAGE('Registros'[Recursos visitados])",
            "formatString": "0.0"
          },
          {
            "name": "Media de anuncios vistos",
            "expression": "AVERAGE('Registros'[Anuncios vistos])",
            "formatString": "0.0"
          },
          {
            "name": "Media de discusiones",
            "expression": "AVERAGE('Registros'[Discusiones])",
            "formatString": "0.0"
          }
        ],
        "partitions": [
          {
            "name": "Registros",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Fuente = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Encabezados = Table.PromoteHeaders(Fuente, [PromoteAllScalars=true]) in Table.TransformColumnTypes(Encabezados, {{\"Clave Nivel\", type text}, {\"Clave Semestre\", type text}, {\"Clave Género\", type text}, {\"Clave Ausencias\", type text}, {\"Clave Clase\", type text}, {\"Clave Asignatura\", type text}, {\"Clave Grado\", type text}, {\"Manos levantadas\", Int64.Type}, {\"Recursos visitados\", Int64.Type}, {\"Anuncios vistos\", Int64.Type}, {\"Discusiones\", Int64.Type}, {\"Encuesta familiar\", type text}, {\"ID de registro\", Int64.Type}, {\"Puntaje codificado\", Int64.Type}, {\"Riesgo\", Int64.Type}}, \"en-US\")"
            }
          }
        ]
