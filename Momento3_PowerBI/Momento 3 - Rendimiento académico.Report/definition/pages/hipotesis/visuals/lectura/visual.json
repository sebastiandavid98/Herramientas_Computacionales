                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#435A70"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Prueba exacta de Fisher. La estimación es la diferencia entre proporciones en puntos porcentuales.",
